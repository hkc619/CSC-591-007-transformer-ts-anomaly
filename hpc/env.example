# 複製成 hpc/env.sh 後填寫真實絕對路徑；env.sh 不加入 Git。
# 也可直接在 shell export，不需要複製這個檔案。
export PROJECT_ROOT=/path/to/transformer_ts_anomaly
export DATA_ROOT=/path/to/SMD
export RESULTS_ROOT=/path/to/tranad-results
export PYTHON_BIN=/path/to/external-python-environment/bin/python
# partition/account 依 Hazel 帳號配置於 sbatch command，勿假設每人相同。
