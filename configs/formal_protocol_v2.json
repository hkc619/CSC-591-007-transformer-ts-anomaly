{
  "protocol": "v2",
  "model": "TranAD",
  "dataset": "SMD",
  "epochs": 5,
  "batch_size": 128,
  "eval_batch_size": 128,
  "window": 10,
  "learning_rate": 0.0001,
  "seed": 1,
  "device": "cpu",
  "dtype": "float64",
  "training_shuffle": true,
  "sampling": "natural_source_size",
  "pot": {
    "q": 1e-05,
    "level": 0.99995,
    "multiplier": 1.06,
    "mode": "source_only_frozen_SPOT_extreme_quantile"
  },
  "labels": "validated_interpretation_label_union",
  "primary_metrics": [
    "pr_auc",
    "raw_precision",
    "raw_recall",
    "raw_f1"
  ],
  "legacy_metrics": [
    "pa_f1"
  ],
